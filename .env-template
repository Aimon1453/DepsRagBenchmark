# LLM Provider Configuration
# Choose one: OpenAI, Azure OpenAI, or Google Gemini
# The system will auto-detect based on which API key is set

# Option 1: OpenAI
OPENAI_API_KEY=your_openai_api_key_here

# Option 2: Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://endpoint.openai.azure.com/  # or AZURE_OPENAI_API_BASE
# AZURE_OPENAI_DEPLOYMENT=deployment-name  # or AZURE_OPENAI_DEPLOYMENT_NAME
# AZURE_OPENAI_API_VERSION=2023-05-15
# AZURE_OPENAI_MODEL_NAME=gpt-4
# AZURE_OPENAI_MODEL_VERSION=1106-Preview

# Option 3: Google Gemini
# GOOGLE_API_KEY=your_google_api_key_here
# GOOGLE_MODEL_ID=gemini-3.1-flash-lite

# E2E only (normally set by benchmark/E2E/e2e_evaluator.py):
# BENCHMARK_E2E=1
# BENCHMARK_OSV_FIXTURE=1
# E2E_OSV_FIXTURE_FILE=benchmark/E2E/fixtures/osv/requests_2_31_0.json

# Neo4j Database Configuration
NEO4J_URI=neo4j+s://your-instance.databases.neo4j.io
NEO4J_USERNAME=neo4j
NEO4J_PASSWORD=your_neo4j_password_here
NEO4J_DATABASE=neo4j

# Optional: For Azure OpenAI
# AZURE_OPENAI_API_KEY=your-azure-openai-key-here
# AZURE_OPENAI_ENDPOINT=https://endpoint.openai.azure.com/  # or AZURE_OPENAI_API_BASE
# AZURE_OPENAI_DEPLOYMENT=deployment-name  # or AZURE_OPENAI_DEPLOYMENT_NAME
# AZURE_OPENAI_API_VERSION=2023-05-15
# AZURE_OPENAI_MODEL_NAME=gpt-4
# AZURE_OPENAI_MODEL_VERSION=1106-Preview

# Optional: For other providers
# ANTHROPIC_API_KEY=your_anthropic_key_here

# Optional: Agno Configuration
# AGNO_TELEMETRY=false  # Disable telemetry if desired